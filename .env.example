# Fonte das atividades: "mongo" ou "arquivo" (data/dataset.jsonl).
# Se omitida, usa "mongo" quando MONGODB_URI estiver definida.
FONTE=mongo

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nome_do_banco
# MONGODB_TIMEOUT_MS=5000

# Fórum(s) a corrigir (coleções forums e forumsposts): IDs separados por vírgula
FORUM_ID=6aa06c4b858e5e12080c0af8
# LIMITE=10             # máximo de posts corrigidos

MODEL=gemma4:e4b

# Melhorias de correção
# REPETICOES=3          # rodadas por atividade; a nota final é a mediana (1 desativa)
# TEMPERATURA=0.4       # padrão: 0.4 com várias rodadas, 0 com uma
# FEW_SHOT=3            # máximo de exemplos do professor no prompt (0 desativa)
# SEED=42
# RESULTADOS=resultados/gemma-fewshot.jsonl   # separar rodadas para comparar
# LIMIAR_DISPERSAO=1.5  # dispersão a partir da qual a nota é de baixa confiança
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TIMEOUT_MS=120000
# TOLERANCIA=0.5
